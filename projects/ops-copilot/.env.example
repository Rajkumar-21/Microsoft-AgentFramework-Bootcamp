# Azure OpenAI (managed identity preferred — leave key empty to use it)
AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_KEY=

# Agent Registry (discover MCP servers + self-register)
REGISTRY_BASE_URL=http://localhost:8000
# Dev token for local; in Azure use a credential + REGISTRY_API_AUDIENCE
REGISTRY_TOKEN=dev
REGISTRY_API_AUDIENCE=

# This agent's public endpoint (used when self-registering)
OPS_COPILOT_ENDPOINT=https://ops-copilot-prod.azurewebsites.net/api/agents/OpsCopilot/run

# Observability (Azure Monitor / Application Insights)
APPLICATIONINSIGHTS_CONNECTION_STRING=
