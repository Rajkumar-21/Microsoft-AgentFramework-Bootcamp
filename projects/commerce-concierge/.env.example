# Azure OpenAI (managed identity preferred — leave key empty to use it)
AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_KEY=

# Agent Registry (discover the warehouse agent + self-register)
REGISTRY_BASE_URL=http://localhost:8000
REGISTRY_TOKEN=dev
REGISTRY_API_AUDIENCE=

# This agent's public endpoint (used when self-registering)
CONCIERGE_ENDPOINT=https://commerce-concierge-prod.azurewebsites.net/api/agents/CommerceConcierge/run

# Fallback warehouse A2A endpoint if the registry is unavailable
WAREHOUSE_A2A_URL=http://localhost:9100

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
