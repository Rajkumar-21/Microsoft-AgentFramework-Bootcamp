# ─── Auth ──────────────────────────────────────────────────────────────────
# "dev"   → no real identity provider; accepts a static dev bearer token.
#           Use ONLY for local development. Every request is treated as an
#           admin unless you send a scoped dev token (see app/security.py).
# "entra" → validate Microsoft Entra ID JWTs (signature, issuer, audience,
#           scopes/roles). Use in any shared or production environment.
REGISTRY_AUTH_MODE=dev

# Required when REGISTRY_AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=api://your-registry-app-client-id
# Optional: restrict which client apps may call the API (comma separated appids)
ENTRA_ALLOWED_CLIENT_IDS=

# ─── Storage ───────────────────────────────────────────────────────────────
# "memory" → in-process store, reseeded on startup. Great for local/dev/tests.
# "cosmos" → Azure Cosmos DB (NoSQL). Auth via DefaultAzureCredential
#            (managed identity in Azure, az login locally) or COSMOS_KEY.
REGISTRY_STORE=memory

COSMOS_ENDPOINT=
COSMOS_DATABASE=agentregistry
# Leave COSMOS_KEY empty to use DefaultAzureCredential (recommended).
COSMOS_KEY=

# ─── App ───────────────────────────────────────────────────────────────────
# Seed sample data on startup (handy in dev; disable in production).
REGISTRY_SEED=true
# Comma-separated allowed CORS origins for the marketplace UI.
CORS_ORIGINS=http://localhost:5173
