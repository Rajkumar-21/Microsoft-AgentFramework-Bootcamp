# Registry API base URL.
VITE_API_BASE_URL=http://localhost:8000

# Auth mode for the UI: "dev" uses a static dev token (matches the API's dev
# mode); "entra" uses MSAL interactive sign-in.
VITE_AUTH_MODE=dev

# Required when VITE_AUTH_MODE=entra
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# The API scope to request, e.g. api://<registry-app-client-id>/Registry.Read
VITE_API_SCOPE=api://your-registry-app-client-id/Registry.Read
