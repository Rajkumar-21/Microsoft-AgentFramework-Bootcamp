# Azure OpenAI / Azure AI Foundry Configuration
# Copy this file to .env and fill in your values

# === Azure OpenAI (ChatClient-based agents) ===
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# === Azure AI Foundry (Hosted Agents via AzureAIAgentsProvider) ===
AZURE_AI_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# === OpenAI (Optional - for OpenAIChatClient) ===
OPENAI_API_KEY=<your-openai-api-key>

# === Optional: Bing Web Search Connection ===
BING_CONNECTION_ID=<your-bing-connection-id>
